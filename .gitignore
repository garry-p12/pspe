__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Generated data and runs. Regenerate with `make data`; never commit.
data/pde_testbeds/*.npz
data/pde_testbeds/*.npy
data/perception_proxy/images/
data/perception_proxy/fields/
data/perception_proxy/captions.json
# Real observational datasets: hundreds of MB to GB, re-downloadable.
data/ndws/
data/pdebench/
data/sen1floods11/
runs/
outputs/
*.pt

# Third-party source PDFs, re-downloadable by the fetch script.
data/lismore/pdf/

# Austin layers: tens of MB, re-fetchable with scripts/fetch_austin_data.py.
data/austin/*.geojson
data/austin_onion/*.geojson

# The built default study: regenerate with scripts/build_austin_study.py.
portal/public/data/austin/study.json

# Cached OpenStreetMap extracts: a fetch result, not source.
data/osm_cache/

# Cached elevation rasters: a fetch result, not source.
data/dem_cache/

# Evacuation experiment inputs: solver output and fetched road geometry,
# rebuilt by `python3 -m baselines.evac.prepare`. The egress table beside
# them is a deterministic function of the two, cached because it costs
# eight minutes of real routing.
data/evac/

# Markdown is not tracked, with one exception: README.md at any level.
#
# The docs stay on disk and remain in git history -- this stops them being
# carried forward in the repository, it does not delete them. Note that this
# also covers portal/CLAUDE.md and portal/AGENTS.md, which are agent
# instructions rather than prose; AGENTS.md is rewritten by `next dev` on
# every run, so ignoring it also ends a standing uncommitted-change.
*.md
!README.md
